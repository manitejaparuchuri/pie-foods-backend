PORT=3000
CATALOG_DATA_SOURCE=mysql
AUTH_PROVIDER=local

# Use either the DB_* variables below or Railway MySQL variables
# (MYSQLHOST, MYSQLPORT, MYSQLUSER, MYSQLPASSWORD, MYSQLDATABASE).
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASS=root
DB_NAME=piefruits

JWT_SECRET=change_me
ADMIN_ID=admin
ADMIN_PASSWORD=change_me

RAZORPAY_KEY_ID=rzp_test_xxxxx
RAZORPAY_KEY_SECRET=change_me
RAZORPAY_WEBHOOK_SECRET=change_me

# Pricing & shipping (all optional — these are the defaults). These also act
# as the fallbacks for the admin-editable shipping config in Firestore
# (site_settings/shipping); admin edits override them per request.
# Keep SHIPPING_FREE_THRESHOLD in sync with the storefront copy.
ORDER_DISCOUNT_RATE=0.2
INCLUSIVE_GST_RATE=0.05
SHIPPING_FREE_THRESHOLD=599
SHIPPING_FEE=49
COD_SURCHARGE=39

CONTACT_TO_EMAIL=your_inbox@example.com
# Where new-order notification emails are sent (falls back to CONTACT_TO_EMAIL).
ORDER_NOTIFY_EMAIL=info@piefoods.com
# Public storefront base URL — used to build the password-reset link.
SITE_BASE_URL=https://www.piefoods.com
BREVO_API_KEY=
# Sender shown on every transactional email (used by both the Brevo HTTP API and
# the SMTP fallback). info@piefoods.com — and the piefoods.com domain — MUST be
# verified/authenticated in the Brevo dashboard (SPF/DKIM), otherwise Brevo
# rejects or rewrites the sender and deliverability suffers.
BREVO_FROM_EMAIL=info@piefoods.com
BREVO_FROM_NAME=PIE Foods
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=

CORS_ALLOWED_ORIGINS=http://localhost:4200

R2_ACCOUNT_ID=your_r2_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=your_r2_bucket_name
R2_PUBLIC_BASE_URL=https://your-public-bucket-url.r2.dev

# Local dev can use FIREBASE_SERVICE_ACCOUNT_PATH. Hosted deploys should use
# FIREBASE_PROJECT_ID + FIREBASE_CLIENT_EMAIL + FIREBASE_PRIVATE_KEY instead.
FIREBASE_SERVICE_ACCOUNT_PATH=
FIREBASE_SERVICE_ACCOUNT_JSON=
FIREBASE_SERVICE_ACCOUNT_BASE64=
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
FIREBASE_WEB_API_KEY=AIzaSyCKqrc0LuDZZsfdAnQEf_IOq161KRiOuWE
FIREBASE_ADMIN_EMAILS=admin@example.com
FIREBASE_USERS_COLLECTION=users
FIREBASE_CATEGORIES_COLLECTION=categories
FIREBASE_PRODUCTS_COLLECTION=products
FIREBASE_COMBOS_COLLECTION=combos
FIREBASE_BANNERS_COLLECTION=banners
FIREBASE_POPULAR_PRODUCTS_COLLECTION=popular_products
